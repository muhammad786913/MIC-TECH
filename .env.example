# ------------------------------------------------------------------
# MIC TECH environment template. Copy to .env.local and fill in.
# NEVER commit real secrets. Production values belong in the host's
# secret manager / Vercel project settings.
# ------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, cookies, SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string. Leave empty for the local JSON store.
MONGODB_URI=
MONGODB_DB=mictech

# Optional explicit driver override: "json" | "mongo"
# DB_DRIVER=json

# Secret used to sign sessions. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# First-run administrator (required in production; seed refuses weak defaults).
ADMIN_EMAIL=admin@mictech.news
ADMIN_PASSWORD=
ADMIN_NAME=MIC TECH Editor

# Email delivery (Resend). When absent, emails are logged to the server console
# and verification/reset links are also returned in development responses.
RESEND_API_KEY=
MAIL_FROM="MIC TECH <no-reply@mictech.news>"
EMAIL_VERIFICATION_REQUIRED=false

# Cloudinary (recommended for production media). When absent, uploads go to
# public/uploads (development only — ephemeral on serverless hosts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mictech

# Protects /api/cron/publish. Generate a random value.
CRON_SECRET=

# Allow development-only convenience links in API responses (never in production).
EXPOSE_DEV_LINKS=false

# Optional: local JSON store directory (defaults to .data)
# DATA_DIR=

# Force the public site into maintenance mode at the edge (true/false).
# The admin Settings toggle also enables maintenance from the database.
MAINTENANCE_MODE=false

# ------------------------------------------------------------------
# Cloudflare (optional, sits in front of Vercel via orange-cloud DNS)
# ------------------------------------------------------------------

# Cloudflare Turnstile — bot protection for signup/login/comment forms.
# Get keys from Cloudflare dashboard → Turnstile → Add site.
# Leave empty to run without Turnstile (dev mode auto-bypasses).
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Client-safe (exposed to browser). Must match the site key above.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Cloudflare R2 — optional object storage for media (alternative to Cloudinary).
# Required only if you want media served from R2 instead of Cloudinary/local.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=mictech-media
CLOUDFLARE_R2_PUBLIC_URL=

# Set to "true" when Vercel domain is orange-cloud proxied through Cloudflare.
# Enables cf-connecting-ip trust and WAF compatibility headers.
CLOUDFLARE_PROXIED=false
